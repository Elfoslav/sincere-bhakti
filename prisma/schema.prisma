generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ChannelRole {
  owner
  admin
  editor
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  password        String
  image           String?
  emailVerifiedAt   DateTime?
  createdAt       DateTime  @default(now())
  renameCount     Int       @default(0)
  sessionVersion  Int       @default(0)
  channels        Channel[]       @relation("ChannelOwner")
  editors         ChannelEditor[]
  media           Media[]
  pendingUploads  PendingUpload[]
  verificationTokens VerificationToken[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  type      String   // "verify" | "reset"
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [email], references: [email], onDelete: Cascade)

  @@unique([email, type])
  @@index([token])
  @@index([expiresAt])
}

model Channel {
  id              String   @id @default(cuid())
  avatarUrl       String?
  isPersonal      Boolean  @default(false)
  renameCount     Int      @default(0)
  defaultLanguage String   @default("en")
  createdAt       DateTime @default(now())
  ownerId         String
  owner    User              @relation("ChannelOwner", fields: [ownerId], references: [id])
  posts    Post[]
  blogPosts BlogPost[]
  editors  ChannelEditor[]
  slugHistory     ChannelSlugHistory[]
  translations    ChannelTranslation[]

  @@index([ownerId, isPersonal])
  @@index([createdAt, id])
}

model ChannelTranslation {
  id                       String   @id @default(cuid())
  channelId                String
  language                 String
  name                     String
  normalizedName           String
  renameCount              Int      @default(0)
  previousNormalizedNames  String[] @default([])
  slug                     String
  channel                  Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  // Names and slugs are unique PER LANGUAGE, not globally: a single channel may
  // reuse the same name/slug across its language translations, and two different
  // channels may not share a name/slug within the same language. Cross-language
  // name ownership (one name belongs to one channel across all languages) is
  // enforced in application code, not by these constraints.
  @@unique([channelId, language])
  @@unique([language, normalizedName])
  @@unique([language, slug])
  @@index([language])
  @@index([channelId])
}

model ChannelSlugHistory {
  id                String   @id @default(cuid())
  oldSlug           String
  oldNormalizedName String
  language          String
  channelId         String
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([language, oldSlug])
  @@index([channelId])
  @@index([oldNormalizedName])
  @@index([language])
}

model ChannelEditor {
  channelId String
  channel   Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChannelRole  @default(editor)

  @@id([channelId, userId])
}

model Post {
  id        String   @id @default(cuid())
  shortId   String   @unique
  slug      String?
  content   String?
  isPublic  Boolean  @default(true)
  language  String   @default("en")
  // Optional publish date (timeline promos of scheduled blog articles carry
  // the article's date so both go live together). Null = visible immediately.
  publishedAt DateTime?
  createdAt DateTime @default(now())
  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  media     Media[]
  // Optional link to a channel blog article: the feed post promotes the
  // article and renders its excerpt with a link to the blog detail.
  blogPostId String?
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: SetNull)
  categories PostCategory[]
  @@index([channelId])
  @@index([isPublic, createdAt])
  @@index([isPublic, publishedAt, createdAt])
  @@index([language, isPublic, createdAt])
  @@index([createdAt, id])
}

model RateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model BlogPost {
  id          String    @id @default(cuid())
  shortId     String    @unique
  title       String
  slug        String?
  excerpt     String?
  content     String?
  // Server-sanitized HTML rendered from the Tiptap JSON in `content`
  // (computed client-side on save, re-sanitized server-side). Null for
  // legacy plain-text articles, which render as escaped paragraphs.
  contentHtml String?
  coverUrl    String?
  isPublic    Boolean   @default(true)
  language    String    @default("en")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  channelId   String
  channel     Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  // Feed posts promoting this article. SetNull from the Post side: deleting
  // the article unlinks promoting posts instead of deleting them.
  posts       Post[]
  categories  BlogPostCategory[]

  @@index([channelId])
  @@index([isPublic, publishedAt, createdAt])
  @@index([language, isPublic, createdAt])
  @@index([createdAt, id])
}

// Unified taxonomy for timeline posts and blog articles. Names are stored
// in canonical Title Case form (see normalizeCategoryName); names are
// unique PER LANGUAGE (like channel translations), and a category only ever
// appears in feeds, pickers, and filters of its own language.
model Category {
  id        String   @id @default(cuid())
  name      String
  // URL slug derived from the name ("Holy Name" → "holy-name"); suffixed
  // when distinct names slugify alike. Lookup key for /blog/category/[slug].
  slug      String
  language  String   @default("en")
  createdAt DateTime @default(now())
  posts     PostCategory[]
  blogPosts BlogPostCategory[]

  @@unique([language, name])
  @@unique([language, slug])
  @@index([language])
}

model PostCategory {
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model BlogPostCategory {
  blogPostId String
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([blogPostId, categoryId])
  @@index([categoryId])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  type      String   // "image" | "video" | "youtube" | "file"
  position  Int      @default(0)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

model PendingUpload {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  channelId String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([key])
  @@index([userId])
}
